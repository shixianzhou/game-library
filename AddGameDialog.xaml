<Window x:Class="GameLibrary.AddGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GameLibrary.Controls"
        Title="添加游戏"
        Width="920" Height="780"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0E100A"
        FontFamily="{StaticResource UiFont}"
        PreviewKeyDown="OnPreviewKeyDown"
        Loaded="OnLoaded">
    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#151810" />
            <Setter Property="BorderBrush" Value="#2C3223" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
        <Style x:Key="FieldHint" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#7E8371" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FolderButton" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="#1A1E15" />
            <Setter Property="BorderBrush" Value="#303626" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#262C1D" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#485039" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#353B2B" BorderThickness="1" Background="#0E100A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="*" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid x:Name="TitleBar" MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel VerticalAlignment="Top" Margin="24,28,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DialogTitle" Text="添加游戏" FontSize="18" FontWeight="Bold" />
                        <Border Background="#23291B" BorderBrush="#3A4230" BorderThickness="1"
                                CornerRadius="4" Padding="7,1" Margin="10,1,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ModeBadge" Text="新游戏" FontSize="9.5" Foreground="#AAB58C" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="DialogSubtitle" Text="把本地游戏收进库里。目录可以现在选，也可以稍后编辑。"
                               FontSize="10.5" Foreground="#858A77" Margin="0,3,0,0" />
                </StackPanel>

                <Button Style="{StaticResource CloseTitleBarButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="44" Height="42" Click="OnCloseClick" ToolTip="关闭">
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                </Button>
            </Grid>

            <!-- 表单 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          controls:ScrollFadeBehavior.Enabled="True"
                          Margin="24,7,24,0" Padding="0,0,8,8">
                <StackPanel>

                    <!-- 基本信息 + 封面 -->
                    <Border Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="208" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,22,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="游戏名称 *" />
                                <TextBox x:Name="NameBox" Style="{StaticResource InputTextBox}"
                                         MaxLength="80" TextChanged="OnNameChanged" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="描述（可选）"
                                           Margin="0,13,0,7" />
                                <TextBox x:Name="DescriptionBox" Style="{StaticResource MultilineTextBox}"
                                         Height="66" MaxLength="600" />

                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="作者（可选）" />
                                        <TextBox x:Name="AuthorBox" Style="{StaticResource InputTextBox}"
                                                 MaxLength="60" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="版本号（可选）" />
                                        <TextBox x:Name="VersionBox" Style="{StaticResource InputTextBox}"
                                                 MaxLength="40" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="封面图（可选）" />
                                <Border Width="196" Height="118" CornerRadius="8" ClipToBounds="True"
                                        Background="#0B0D08" BorderBrush="#343A2A" BorderThickness="1">
                                    <controls:ArtworkView x:Name="CoverPreview" CornerRadius="8" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="5,9,0,0">
                                    <Button Style="{StaticResource SecondaryButton}" Content="选择图片"
                                            Height="31" Padding="12,0" FontSize="11" Click="OnChooseCoverClick" />
                                    <Button x:Name="RemoveCoverButton" Style="{StaticResource GhostButton}"
                                            Content="移除" Height="31" Padding="9,0" FontSize="11"
                                            Margin="4,0,0,0" Click="OnRemoveCoverClick" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,0"
                                           Text="支持 JPG / PNG / BMP，建议横图。" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 启动方式 -->
                    <Border Style="{StaticResource SectionCard}" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="启动方式" FontSize="14" FontWeight="Bold" />
                                    <TextBlock x:Name="SeparatedHint" Style="{StaticResource FieldHint}"
                                               Margin="0,4,0,0"
                                               Text="客户端和服务端在同一个目录，启动时只需要一个程序。" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="客户端 / 服务端分离" FontSize="11.5"
                                               Foreground="#B7BAA9" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ToggleButton x:Name="SeparatedToggle" Style="{StaticResource ToggleSwitch}"
                                                  Checked="OnSeparatedChanged" Unchecked="OnSeparatedChanged" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#282D20" Margin="0,14,0,14" />

                            <!-- 不分离 -->
                            <StackPanel x:Name="SinglePanel">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="游戏目录 *"
                                           Margin="0,0,0,7" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SingleDirectoryBox" Style="{StaticResource InputTextBox}"
                                             ToolTip="游戏所在目录" />
                                    <Button Grid.Column="2" Style="{StaticResource FolderButton}"
                                            Click="OnBrowseSingleDirectory" ToolTip="选择游戏目录">
                                        <Path Data="{StaticResource FolderGeometry}" Width="18" Height="18"
                                              Stretch="Uniform" Stroke="#C9CCBA" StrokeThickness="1.25"
                                              StrokeLineJoin="Round" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,5,0,0"
                                           Text="启动程序留空时，会自动在目录里寻找最合适的 exe。" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="启动程序"
                                           Margin="0,13,0,7" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SingleExecutableBox" Style="{StaticResource InputTextBox}"
                                             ToolTip="留空则根据目录自动识别" />
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="选择"
                                            Height="40" Padding="14,0" Click="OnBrowseSingleExecutable" />
                                    <Button Grid.Column="4" Style="{StaticResource GhostButton}" Content="自动"
                                            Height="40" Padding="11,0" Click="OnClearSingleExecutable"
                                            ToolTip="清空手动选择，启动时自动识别" />
                                </Grid>
                            </StackPanel>

                            <!-- 分离 -->
                            <Grid x:Name="SeparatedPanel" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Background="#10130C" BorderBrush="#2A3021" BorderThickness="1"
                                        CornerRadius="8" Padding="13">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="12" Foreground="#8FB55B" Margin="0,0,7,0" />
                                            <TextBlock Text="客户端目录" FontSize="12.5" FontWeight="Bold" />
                                            <TextBlock Text="必填" FontSize="9.5" Foreground="#7E8371"
                                                       Margin="7,2,0,0" />
                                        </StackPanel>
                                        <Grid Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ClientDirectoryBox" Style="{StaticResource InputTextBox}"
                                                     ToolTip="客户端所在目录" />
                                            <Button Grid.Column="2" Style="{StaticResource FolderButton}"
                                                    Click="OnBrowseClientDirectory" ToolTip="选择客户端目录">
                                                <Path Data="{StaticResource FolderGeometry}" Width="18" Height="18"
                                                      Stretch="Uniform" Stroke="#C9CCBA" StrokeThickness="1.25"
                                                      StrokeLineJoin="Round" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Button>
                                        </Grid>

                                        <TextBlock Style="{StaticResource FieldLabel}" Text="客户端启动程序"
                                                   Margin="0,11,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ClientExecutableBox" Style="{StaticResource InputTextBox}"
                                                     ToolTip="留空则自动识别客户端程序" />
                                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="选择"
                                                    Height="40" Padding="11,0" Click="OnBrowseClientExecutable" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,5,0,0"
                                                   Text="留空时，启动会自动寻找客户端程序。" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#10130C" BorderBrush="#2A3021"
                                        BorderThickness="1" CornerRadius="8" Padding="13">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="12" Foreground="#C6A96B" Margin="0,1,7,0" />
                                            <TextBlock Text="服务端目录" FontSize="12.5" FontWeight="Bold" />
                                            <TextBlock Text="必填" FontSize="9.5" Foreground="#7E8371"
                                                       Margin="7,2,0,0" />
                                        </StackPanel>
                                        <Grid Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ServerDirectoryBox" Style="{StaticResource InputTextBox}"
                                                     ToolTip="服务端所在目录" />
                                            <Button Grid.Column="2" Style="{StaticResource FolderButton}"
                                                    Click="OnBrowseServerDirectory" ToolTip="选择服务端目录">
                                                <Path Data="{StaticResource FolderGeometry}" Width="18" Height="18"
                                                      Stretch="Uniform" Stroke="#C9CCBA" StrokeThickness="1.25"
                                                      StrokeLineJoin="Round" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Button>
                                        </Grid>

                                        <TextBlock Style="{StaticResource FieldLabel}" Text="服务端启动程序"
                                                   Margin="0,11,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ServerExecutableBox" Style="{StaticResource InputTextBox}"
                                                     ToolTip="留空则自动识别服务端程序" />
                                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="选择"
                                                    Height="40" Padding="11,0" Click="OnBrowseServerExecutable" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,5,0,0"
                                                   Text="留空时，启动会自动寻找服务端程序。" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Height="1" Background="#282D20" Margin="0,14,0,14" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="启动参数（可选）"
                                       Margin="0,0,0,7" />
                            <TextBox x:Name="ArgumentsBox" Style="{StaticResource InputTextBox}"
                                     ToolTip="原样附加在客户端启动程序之后，例如 -windowed &quot;D:\日志&quot;" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,5,0,0"
                                       Text="选填，只传给客户端。参数会原样拼在启动程序后面，含空格的参数请用英文双引号包起来，例如 &quot;我是参数1&quot; &quot;我是参数2&quot;。" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource FieldHint}" Margin="2,10,0,2"
                               Text="游戏名称和游戏目录是必填项，其余信息以后都可以在右键菜单里修改。" />
                </StackPanel>
            </ScrollViewer>

            <!-- 底部操作 -->
            <Border Grid.Row="2" BorderBrush="#272D1F" BorderThickness="0,1,0,0"
                    Background="#11140D" Padding="24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ErrorGlyph" Text="&#xE783;" FontFamily="{StaticResource IconFont}"
                                   FontSize="12" Foreground="#D36A5F" Visibility="Collapsed"
                                   VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock x:Name="ErrorText" FontSize="11.5" Foreground="#D36A5F"
                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Content="取消"
                                Height="38" MinWidth="92" Padding="18,0" Margin="0,0,9,0"
                                Click="OnCloseClick" />
                        <Button x:Name="SubmitButton" Style="{StaticResource PrimaryButton}"
                                Content="添加游戏" Height="38" MinWidth="116" Padding="22,0"
                                Click="OnSubmitClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
