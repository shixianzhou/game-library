<Window x:Class="GameLibrary.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="游戏库"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#A8000000"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid x:Name="Backdrop" MouseLeftButtonDown="OnBackdropMouseDown">
        <Border x:Name="Card"
                Width="470"
                MaxWidth="470"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1A1E14"
                BorderBrush="#3B4231"
                BorderThickness="1"
                CornerRadius="13"
                Padding="24,21,24,20"
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270"
                                  Color="#000000" Opacity="0.55" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardOffset" Y="10" />
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="38" Height="38" CornerRadius="9"
                            Background="#262D1E" BorderBrush="#444D36" BorderThickness="1"
                            VerticalAlignment="Top" Margin="0,1,14,0">
                        <TextBlock x:Name="GlyphText" Text="&#xE946;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="17" Foreground="#B7C58F"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="TitleText" Text="提示"
                                   FontSize="19" FontWeight="Bold" />
                        <TextBlock x:Name="MessageText" Text=""
                                   Margin="0,9,0,0" FontSize="12.5" LineHeight="21"
                                   Foreground="#C9C6B8" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,22,0,0">
                    <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}"
                            Content="取消" Height="36" MinWidth="82" Padding="18,0"
                            Margin="0,0,9,0" Click="OnCancelClick" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}"
                            Content="确定" Height="36" MinWidth="96" Padding="20,0"
                            Click="OnConfirmClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
