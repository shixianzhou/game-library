<Window x:Class="GameLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GameLibrary.Controls"
        Title="游戏库"
        Icon="assets/app-icon.png"
        Width="1380" Height="900"
        MinWidth="1080" MinHeight="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="OnLoaded"
        Closing="OnClosing"
        StateChanged="OnStateChanged"
        Activated="OnActivated"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="AppAccentBrush" Color="#80A94E" />
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.08*" MinHeight="380" />
            <RowDefinition Height="*" MinHeight="300" />
        </Grid.RowDefinitions>

        <!-- ============================ 主视觉 ============================ -->
        <Grid x:Name="Hero" Grid.Row="0" ClipToBounds="False">
            <controls:ArtworkView x:Name="HeroArtwork"
                                  IsHero="True"
                                  GameName="游戏库"
                                  SeedText="library-default" />

            <Grid x:Name="HeroImageLayer" Visibility="Collapsed" Margin="0,0,0,-110">
                <Image x:Name="HeroImageA" Stretch="UniformToFill" />
                <Image x:Name="HeroImageB" Stretch="UniformToFill" Opacity="0" />
                <Rectangle x:Name="HeroTileRect" Visibility="Collapsed" />
            </Grid>

            <MediaElement x:Name="HeroVideo"
                          Margin="0,0,0,-110"
                          Visibility="Collapsed"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Manual"
                          Stretch="UniformToFill"
                          IsMuted="True"
                          Volume="0"
                          MediaOpened="OnVideoMediaOpened"
                          MediaEnded="OnVideoMediaEnded"
                          MediaFailed="OnVideoMediaFailed" />

            <!-- 保证左侧文字可读的渐变 -->
            <Rectangle IsHitTestVisible="False" Margin="0,0,0,-110">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#E810120B" Offset="0" />
                        <GradientStop Color="#D010120B" Offset="0.30" />
                        <GradientStop Color="#8010120B" Offset="0.60" />
                        <GradientStop Color="#2410120B" Offset="0.86" />
                        <GradientStop Color="#0010120B" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Height="130" VerticalAlignment="Top" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#8C000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Border x:Name="HeroTint" IsHitTestVisible="False" Opacity="0.55" Margin="0,0,0,-110">
                <Border.Background>
                    <RadialGradientBrush Center="0.78,0.35" GradientOrigin="0.78,0.35" RadiusX="0.65" RadiusY="0.8">
                        <GradientStop Color="#5580A94E" Offset="0" />
                        <GradientStop Color="#0080A94E" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- 顶部栏 -->
            <Grid x:Name="TopBar" Height="58" VerticalAlignment="Top"
                  Background="Transparent" MouseLeftButtonDown="OnTopBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="26,0,0,0" VerticalAlignment="Center">
                    <Grid Width="27" Height="27">
                        <Border Background="#1B1E15" BorderBrush="#4B5439" BorderThickness="1" CornerRadius="6" />
                        <Rectangle Width="15" Height="7" Fill="#80A94E" RadiusX="1" RadiusY="1" VerticalAlignment="Center" Margin="0,-6,0,0" />
                        <Rectangle Width="15" Height="6" Fill="#4B3526" RadiusX="1" RadiusY="1" VerticalAlignment="Center" Margin="0,5,0,0" />
                        <Rectangle Width="6" Height="3" Fill="#A8CE72" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="7,0,0,0" />
                    </Grid>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="游戏库" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="G A M E   L I B R A R Y" FontSize="8.5" Foreground="#A7AB99" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="MenuButton" Style="{StaticResource TitleBarButton}" Width="40"
                            Click="OnMenuButtonClick" ToolTip="菜单">
                        <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AppMenu" Placement="Bottom">
                                <MenuItem Header="添加游戏" Click="OnMenuAddGame">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="设置" Click="OnMenuSettings">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="打开数据目录" Click="OnMenuOpenData">
                                    <MenuItem.Icon>
                                        <Path Data="{StaticResource FolderGeometry}" Width="14" Height="14"
                                              Stretch="Uniform" Stroke="#D8DCCB" StrokeThickness="1.3"
                                              StrokeLineJoin="Round" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="关于游戏库" Click="OnMenuAbout">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Border Width="1" Height="18" Background="#33FFFFFF" Margin="7,0,7,0" />

                    <Button Style="{StaticResource TitleBarButton}" Click="OnMinimizeClick" ToolTip="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Click="OnMaximizeClick" ToolTip="最大化">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource CloseTitleBarButton}" Click="OnCloseClick" ToolTip="关闭">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 游戏主视觉内容 -->
            <Grid x:Name="HeroGamePanel" VerticalAlignment="Bottom" Margin="56,0,96,46">
                <StackPanel HorizontalAlignment="Left" MaxWidth="740">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                        <Border Width="4" Height="14" CornerRadius="1.5"
                                Background="{DynamicResource AppAccentBrush}" Margin="0,1,9,0" />
                        <TextBlock x:Name="HeroEyebrow" Text="最近游玩"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AppAccentBrush}" />
                    </StackPanel>

                    <TextBlock x:Name="HeroTitle" Text="游戏库"
                               FontSize="58" FontWeight="Black" Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis" LineHeight="66">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.55" Color="#000000" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <ItemsControl x:Name="HeroTags" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock x:Name="HeroDescription" Margin="0,15,0,0"
                               MaxWidth="640" FontSize="14" LineHeight="25"
                               Foreground="#D6D3C4" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="78" />

                    <StackPanel Orientation="Horizontal" Margin="0,25,0,0">
                        <Button x:Name="HeroLaunchButton" Style="{StaticResource PrimaryButton}"
                                Height="50" Padding="28,0" Click="OnHeroLaunchClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="White" />
                                <TextBlock Text="启动游戏" FontSize="14" FontWeight="Bold"
                                           Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="HeroServerButton" Style="{StaticResource SecondaryButton}"
                                Height="50" Padding="23,0" Margin="10,0,0,0"
                                Click="OnHeroServerClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,1,9,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="启动后台" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="HeroFolderButton" Style="{StaticResource SecondaryButton}"
                                Width="50" Height="50" Padding="0" Margin="10,0,0,0"
                                Click="OnHeroFolderClick" ToolTip="打开游戏目录">
                            <Path Data="{StaticResource FolderGeometry}" Width="19" Height="19"
                                  Stretch="Uniform" Stroke="#E6E8DB" StrokeThickness="1.25"
                                  StrokeLineJoin="Round" HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 空库主视觉 -->
            <Grid x:Name="HeroEmptyPanel" VerticalAlignment="Bottom" Margin="56,0,96,48" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Left" MaxWidth="650">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                        <Border Width="4" Height="14" CornerRadius="1.5"
                                Background="{DynamicResource AppAccentBrush}" Margin="0,1,9,0" />
                        <TextBlock Text="本地游戏库" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AppAccentBrush}" />
                    </StackPanel>
                    <TextBlock Text="把喜欢的游戏，收进一个地方。" FontSize="46" FontWeight="Black"
                               Foreground="{StaticResource TextBrush}" LineHeight="56">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.55" Color="#000000" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Margin="0,15,0,0" MaxWidth="560" FontSize="14" LineHeight="25"
                               Foreground="#D6D3C4" TextWrapping="Wrap"
                               Text="添加本地游戏的目录，客户端和服务端可以分开启动。封面、描述、版本信息都由你决定。" />
                    <Button Style="{StaticResource PrimaryButton}" Height="50" Padding="26,0"
                            HorizontalAlignment="Left" Margin="0,25,0,0" Click="OnAddGameClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,9,0" Foreground="White" />
                            <TextBlock Text="添加游戏" FontSize="14" FontWeight="Bold"
                                       Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 右侧快捷启动栏 -->
            <StackPanel x:Name="RailPanel" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,78,60,0" />
        </Grid>

        <!-- ============================ 游戏列表 ============================ -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="1" Background="{StaticResource BgBrush}" />

            <Rectangle Grid.Row="1" Height="75" VerticalAlignment="Top" Margin="0,-70,0,0"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#000E100A" Offset="0" />
                        <GradientStop Color="#8C0E100A" Offset="0.55" />
                        <GradientStop Color="#E80E100A" Offset="0.88" />
                        <GradientStop Color="#FF0E100A" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid x:Name="GamesHeader" Background="{StaticResource BgBrush}" Margin="56,18,56,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="全部游戏" FontSize="22" FontWeight="Bold" />
                    <Border Background="#1D2117" BorderBrush="#2E3425" BorderThickness="1"
                            CornerRadius="5" Padding="8,1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <Border.RenderTransform>
                            <TranslateTransform Y="2" />
                        </Border.RenderTransform>
                        <TextBlock x:Name="GameCountText" Text="0" FontSize="12"
                                   Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="LibraryMetaText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
            </Grid>

            <ScrollViewer x:Name="GamesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          controls:ScrollFadeBehavior.Enabled="True"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                          Margin="56,16,52,0" Padding="0,0,0,26">
                <controls:AutoUniformGrid x:Name="GamesPanel" CardHeight="288" Gap="18" MinCardWidth="250" />
            </ScrollViewer>

            <Grid x:Name="EmptyPanel" Grid.Row="1" Margin="56,16,56,26" Visibility="Collapsed">
                <Border Background="#131610" BorderBrush="#303628" BorderThickness="1" CornerRadius="12">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="58" Height="58" CornerRadius="29" Background="#1E2317"
                                BorderBrush="#3A4230" BorderThickness="1" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                       Foreground="#8FA46A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="游戏库还是空的" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Text="点击这里添加第一款游戏，之后所有启动都在一个地方。"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="添加游戏"
                                Height="38" Padding="22,0" HorizontalAlignment="Center"
                                Margin="0,18,0,0" Click="OnAddGameClick" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 浮层提示 -->
        <Border x:Name="Toast" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,26" Background="#F21C2117" BorderBrush="#424A36" BorderThickness="1"
                CornerRadius="9" Padding="16,10" Opacity="0" IsHitTestVisible="False"
                Panel.ZIndex="20">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastGlyph" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                           FontSize="13" Foreground="{StaticResource GrassBrush}"
                           VerticalAlignment="Center" Margin="0,0,9,0" />
                <TextBlock x:Name="ToastText" Text="" FontSize="12" Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center" MaxWidth="680" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

