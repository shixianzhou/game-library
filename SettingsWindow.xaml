<Window x:Class="GameLibrary.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GameLibrary.Controls"
        Title="设置"
        Width="960" Height="650"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0E100A"
        FontFamily="{StaticResource UiFont}"
        PreviewKeyDown="OnPreviewKeyDown"
        Loaded="OnLoaded">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FocuslessButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B8BCAA" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Grid>
                                <Border x:Name="AccentBar" Width="3" Height="17" CornerRadius="1.5"
                                        Background="#8FB55B" HorizontalAlignment="Left"
                                        Opacity="0" />
                                <ContentPresenter Margin="15,0,10,0" VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D2218" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="selected">
                                <Setter TargetName="Bd" Property="Background" Value="#252B1D" />
                                <Setter TargetName="AccentBar" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#151810" />
            <Setter Property="BorderBrush" Value="#2C3223" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="18,3" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingDesc" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#7F8472" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionCaption" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#8D927F" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#353B2B" BorderThickness="1" Background="#0E100A">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="184" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Background="#11140D" BorderBrush="#272C1F" BorderThickness="0,0,1,0">
                <Grid Margin="16,24,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="4,0,0,24">
                        <TextBlock Text="设置" FontSize="23" FontWeight="Black" />
                        <TextBlock Text="S E T T I N G S" FontSize="8.5" Foreground="#7B806D"
                                   Margin="1,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button x:Name="BackgroundNav" Style="{StaticResource NavButton}"
                                Tag="selected" Click="OnBackgroundNavClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" Margin="0,0,11,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="背景" FontSize="12.5" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="VersionsNav" Style="{StaticResource NavButton}"
                                Click="OnVersionsNavClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" Margin="0,0,11,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="版本" FontSize="12.5" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="4,0,0,0">
                        <TextBlock Text="本地游戏库" FontSize="10.5" Foreground="#8A8F7B" />
                        <TextBlock Text="v1.0.0" FontSize="10" Foreground="#5E6354" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧内容 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="64" />
                </Grid.RowDefinitions>

                <Grid x:Name="PageHeader" MouseLeftButtonDown="OnTitleBarMouseDown">
                    <TextBlock x:Name="PageTitle" Text="背景" FontSize="19" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="28,0,0,0" />
                    <Button Style="{StaticResource CloseTitleBarButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="44" Height="42" Click="OnCloseClick" ToolTip="关闭">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                    </Button>
                </Grid>

                <!-- 背景页 -->
                <ScrollViewer x:Name="BackgroundPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              controls:ScrollFadeBehavior.Enabled="True"
                              Margin="28,2,28,0" Padding="0,0,8,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionCaption}" Text="素材目录" />

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <StackPanel Margin="0,13">
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="图片目录" />
                                    <TextBlock Style="{StaticResource SettingDesc}"
                                               Text="目录中的 JPG / PNG / BMP / GIF 会轮播展示。" />
                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ImageDirectoryBox" Style="{StaticResource InputTextBox}" />
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                Width="40" Height="40" VerticalAlignment="Center"
                                                Background="#1A1E15" BorderBrush="#303626" BorderThickness="1"
                                                Click="OnBrowseImageDirectory" ToolTip="选择图片目录">
                                            <Path Data="{StaticResource FolderGeometry}" Width="18" Height="18"
                                                  Stretch="Uniform" Stroke="#C9CCBA" StrokeThickness="1.25"
                                                  StrokeLineJoin="Round" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <Border Height="1" Background="#282D20" />

                                <StackPanel Margin="0,13">
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="视频目录" />
                                    <TextBlock Style="{StaticResource SettingDesc}"
                                               Text="视频优先于图片播放；目录为空时使用图片背景。" />
                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="VideoDirectoryBox" Style="{StaticResource InputTextBox}" />
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                Width="40" Height="40" VerticalAlignment="Center"
                                                Background="#1A1E15" BorderBrush="#303626" BorderThickness="1"
                                                Click="OnBrowseVideoDirectory" ToolTip="选择视频目录">
                                            <Path Data="{StaticResource FolderGeometry}" Width="18" Height="18"
                                                  Stretch="Uniform" Stroke="#C9CCBA" StrokeThickness="1.25"
                                                  StrokeLineJoin="Round" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionCaption}" Text="显示" Margin="2,22,0,8" />

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <Grid Margin="0,14">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="显示方式" />
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="背景铺满主视觉区域的方式。" />
                                    </StackPanel>
                                    <ComboBox x:Name="DisplayModeCombo" Style="{StaticResource DarkComboBox}"
                                              Width="156" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ComboBoxItem Content="填充" />
                                        <ComboBoxItem Content="适应" />
                                        <ComboBoxItem Content="拉伸" />
                                        <ComboBoxItem Content="平铺" />
                                    </ComboBox>
                                </Grid>

                                <Border Height="1" Background="#282D20" />

                                <Grid Margin="0,14">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="动态配色" />
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="窗口高亮色跟随当前背景图的主色变化。" />
                                    </StackPanel>
                                    <ToggleButton x:Name="DynamicColorToggle" Style="{StaticResource ToggleSwitch}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Border Height="1" Background="#282D20" />

                                <Grid Margin="0,14">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}"
                                                   Text="窗口失去焦点时暂停播放" />
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="暂停视频解码，窗口重新获得焦点后继续播放。" />
                                    </StackPanel>
                                    <ToggleButton x:Name="PauseToggle" Style="{StaticResource ToggleSwitch}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SettingDesc}" Margin="2,10,0,4"
                                   Text="背景只影响顶部主视觉；内容区保持深色，避免卡片和文字看不清。" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 版本页 -->
                <Grid x:Name="VersionsPanel" Grid.Row="1" Visibility="Collapsed" Margin="28,2,28,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,4,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionsCount" Text="共 0 个" FontSize="11.5"
                                       Foreground="#8D927F" />
                            <TextBlock Text="· 修改会立即保存" FontSize="10.5"
                                       Foreground="#666B5B" Margin="8,0,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="添加游戏"
                                Height="34" Padding="16,0" HorizontalAlignment="Right"
                                Click="OnAddVersionClick" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  controls:ScrollFadeBehavior.Enabled="True"
                                  Padding="0,0,8,8">
                        <StackPanel>
                            <StackPanel x:Name="VersionsListPanel" />
                            <Border x:Name="VersionsEmptyPanel" Background="#141710"
                                    BorderBrush="#2C3223" BorderThickness="1" CornerRadius="9"
                                    Padding="26" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}"
                                               FontSize="24" Foreground="#6F7C55"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="游戏库还是空的" FontSize="14" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                                    <TextBlock Text="点右上角添加游戏，或回到主界面添加。"
                                               FontSize="11" Foreground="#858A77"
                                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 底部 -->
                <Border Grid.Row="2" BorderBrush="#272D1F" BorderThickness="0,1,0,0"
                        Background="#11140D" Padding="28,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="FooterError" FontSize="11.5" Foreground="#D36A5F"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="480" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButton}" Content="取消"
                                    Height="38" MinWidth="92" Padding="18,0" Margin="0,0,9,0"
                                    Click="OnCancelClick" />
                            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="保存"
                                    Height="38" MinWidth="106" Padding="22,0"
                                    Click="OnSaveClick" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
